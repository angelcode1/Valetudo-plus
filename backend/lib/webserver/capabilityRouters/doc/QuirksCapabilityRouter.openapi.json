                      }
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "readOnly": {
                      "type": "boolean"
                    },
                    "rawValue": {
                      "type": "integer",
                      "nullable": true
                    },
                    "unavailableReason": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
