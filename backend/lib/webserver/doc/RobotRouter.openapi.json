{
  "/api/v2/robot": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot info",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "manufacturer": {
                    "type": "string"
                  },
                  "modelName": {
                    "type": "string"
                  },
                  "modelDetails": {
                    "type": "object",
                    "properties": {
                      "supportedAttachments": {
                        "type": "array",
                        "description": "Attachments that are detected and reported by the robot",
                        "items": {
                          "$ref": "#/components/schemas/AttachmentStateAttributeType"
                        }
                      },
                      "supportedDockComponents": {
                        "type": "array",
                        "description": "Dock components that are detected and reported by the robot",
                        "items": {
                          "$ref": "#/components/schemas/DockComponentStateAttributeType"
                        }
                      }
                    }
                  },
                  "implementation": {
                    "type": "string",
                    "description": "Valetudo robot implementation in use"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/clean-genius/status": {
    "get": {
      "tags": ["Robot"],
      "summary": "Get cached X40 CleanGenius settings (read-only)",
      "description": "X40 Ultra only (404 on other models). Returns passive normal-poll lifecycle (not started, in progress, succeeded, failed) and cached 4:50/4:1/4:7 state without robot I/O. Successful poll completion does not imply valid MIOT settings or idle state. Unknown numeric sentinels are preserved; stale observations are explicitly marked. Does not perform any additional read or write.",
      "responses": {
        "200": {
          "description": "A redacted allowlisted status observation or unavailable state",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source": {"type": "string", "enum": ["miot_4_50"]},
                  "readOnly": {"type": "boolean", "enum": [true]},
                  "dataType": {"type": "string", "enum": ["native_settings_not_sensor_measurements"]},
                  "state": {"type": "string", "enum": ["observed", "stale", "unavailable"]},
                  "observedAt": {"type": "string", "nullable": true, "format": "date-time"},
                  "ageMs": {"type": "integer", "nullable": true},
                  "stale": {"type": "boolean"},
                  "valetudoPolicy": {"type": "string"},
                  "settings": {
                    "type": "object",
                    "description": "Only cleanGenius, autoReclean, autoRewash, stainIdentification, hotWash; each has value (integer or null) and state (known interpretation or unknown/unavailable)"
                  },
                  "nativeMopDirtiness": {"type": "string"},
                  "pollHealth": {
                    "type": "object",
                    "description": "Read-only lifecycle of existing normal state polls; this status route does not trigger a new MIOT request. A completed poll does not prove individual properties valid.",
                    "properties": {
                      "state": {"type": "string", "enum": ["not_started", "in_progress", "succeeded", "failed"]},
                      "lastAttemptAt": {"type": "string", "nullable": true, "format": "date-time"}
                    }
                  },
                  "cachedIdle": {
                    "type": "object",
                    "description": "Passive allowlisted raw MODE 4:1 and TASK_STATUS 4:7 from existing poll cache only. NOT authorization to write; does not make a new MIOT read.",
                    "properties": {
                      "source": {"type": "string", "enum": ["cached_miot_4_1_4_7"]},
                      "state": {"type": "string", "enum": ["observed", "stale", "unavailable"]},
                      "observedAt": {"type": "string", "nullable": true, "format": "date-time"},
                      "ageMs": {"type": "integer", "nullable": true},
                      "mode": {"type": "integer", "nullable": true},
                      "taskStatus": {"type": "integer", "nullable": true},
                      "cachedGuardMatch": {"type": "boolean"}
                    }
                  },
                  "dockWashActivity": {
                    "type": "object",
                    "description": "Read-only, bounded changes in already-polled MIOT mop-dock status. NOT measured mop dirtiness, water turbidity or proven rewash decisions.",
                    "properties": {
                      "source": {"type": "string", "enum": ["miot_mop_dock_status"]},
                      "dataType": {"type": "string"},
                      "state": {"type": "string", "enum": ["observed", "stale", "unavailable"]},
                      "observedAt": {"type": "string", "nullable": true, "format": "date-time"},
                      "ageMs": {"type": "integer", "nullable": true},
                      "stale": {"type": "boolean"},
                      "current": {"type": "object"},
                      "transitions": {"type": "array", "maxItems": 12, "items": {"type": "object"}}
                    }
                  }
                }
              }
            }
          }
        },
        "404": {"description": "This model does not implement the X40 read-only status endpoint"}
      }
    }
  },
  "/api/v2/robot/properties": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot-specific properties",
      "responses": {
        "200": {
          "description": "A flat key/value object containing 0..* properties that are specific to this robot.\n\nThis can for example be the firmware version.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot state",
      "description": "Retrieve the robot state.\n\nNote! If the map is available, trying this out on Swagger will likely **use lots of RAM and hang your\nbrowser tab.**\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "attributes": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/AttachmentStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/BatteryStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/DockComponentStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/DockStatusStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/PresetSelectionStateAttribute"
                        },
                        {
                          "$ref": "#/components/schemas/StatusStateAttribute"
                        }
                      ]
                    }
                  },
                  "map": {
                    "$ref": "#/components/schemas/ValetudoMap"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/attributes": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot state attributes",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AttachmentStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/BatteryStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/DockComponentStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/DockStatusStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/PresetSelectionStateAttribute"
                    },
                    {
                      "$ref": "#/components/schemas/StatusStateAttribute"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/map": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot map",
      "description": "Retrieve the robot map.\n\nNote! If the map is available, trying this out on Swagger will likely **use lots of RAM and hang your\nbrowser tab.**\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValetudoMap"
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/sse": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot state (SSE events)",
      "description": "Retrieve the robot state.\n\nNote! This endpoint provides SSE events. Swagger does not support it.\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "text/event-stream": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/attributes/sse": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot state attributes (SSE events)",
      "description": "Retrieve the robot state attributes.\n\nNote! This endpoint provides SSE events. Swagger does not support it.\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "text/event-stream": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/state/map/sse": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Get robot map (SSE events)",
      "description": "Retrieve the robot map\n\nNote! This endpoint provides SSE events. Swagger does not support it.\n",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "text/event-stream": {
              "schema": {
                "$ref": "#/components/schemas/ValetudoMap"
              }
            }
          }
        }
      }
    }
  },
  "/api/v2/robot/clean-genius/native-settings": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Read fresh X40 observations without state parsing or writes",
      "responses": {
        "200": {
          "description": "Read-only observations; not write authorization",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "readOnly": {
                    "type": "boolean"
                  },
                  "observedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "settings": {
                    "type": "object",
                    "description": "Only cleanGenius, autoReclean, autoRewash, stainIdentification, hotWash; each has value (integer or null) and state (known interpretation or unknown/unavailable)"
                  }
                }
              }
            }
          }
        },
        "404": {
          "description": "Unsupported robot"
        },
        "502": {
          "description": "Fresh observation unavailable"
        }
      }
    }
  },
  "/api/v2/robot/clean-genius/preflight": {
    "get": {
      "tags": [
        "Robot"
      ],
      "summary": "Read fresh X40 observations without state parsing or writes",
      "responses": {
        "200": {
          "description": "Read-only observations; not write authorization",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "readOnly": {
                    "type": "boolean"
                  },
                  "observedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "mode": {
                    "type": "integer"
                  },
                  "taskStatus": {
                    "type": "integer"
                  },
                  "chargeCode": {
                    "type": "integer"
                  },
                  "dockWashCode": {
                    "type": "integer"
                  },
                  "errorClear": {
                    "type": "boolean"
                  },
                  "activationAllowed": {
                    "type": "boolean"
                  },
                  "blockedReason": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "404": {
          "description": "Unsupported robot"
        },
        "502": {
          "description": "Fresh observation unavailable"
        }
      }
    }
  },
